# Database configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=weatherapi
DB_SSL_MODE=disable

# User Service Database configuration (separate database for microservices)
USER_DB_HOST=user-db
USER_DB_PORT=5433
USER_DB_USER=postgres
USER_DB_PASSWORD=postgres
USER_DB_NAME=userapi
USER_DB_SSL_MODE=disable

# Subscription Service Database configuration (separate database for microservices)
SUBSCRIPTION_DB_HOST=subscription-db
SUBSCRIPTION_DB_PORT=5434
SUBSCRIPTION_DB_USER=postgres
SUBSCRIPTION_DB_PASSWORD=postgres
SUBSCRIPTION_DB_NAME=subscriptionapi
SUBSCRIPTION_DB_SSL_MODE=disable

# Server configuration
SERVER_PORT=8080

# Microservices configuration
SERVICES_WEATHER_PORT=8081
SERVICES_WEATHER_HOST=localhost
SERVICES_USER_PORT=8082
SERVICES_USER_HOST=localhost
SERVICES_SUBSCRIPTION_PORT=8083
SERVICES_SUBSCRIPTION_HOST=localhost
SERVICES_NOTIFICATION_PORT=8084
SERVICES_NOTIFICATION_HOST=localhost

# Weather API configuration
# Primary provider (WeatherAPI.com)
WEATHER_API_KEY=your_weatherapi_com_key
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1

# Additional weather providers (optional)
OPENWEATHERMAP_API_KEY=your_openweathermap_key
OPENWEATHERMAP_API_BASE_URL=https://api.openweathermap.org/data/2.5
ACCUWEATHER_API_KEY=your_accuweather_key
ACCUWEATHER_API_BASE_URL=http://dataservice.accuweather.com/currentconditions/v1

# Weather provider settings
WEATHER_PROVIDER_ORDER=weatherapi,openweathermap,accuweather
WEATHER_ENABLE_CACHE=true
WEATHER_ENABLE_LOGGING=true
WEATHER_CACHE_TTL_MINUTES=10
WEATHER_LOG_FILE_PATH=logs/weather_providers.log

# Cache configuration
CACHE_TYPE=memory
# Redis cache settings (used when CACHE_TYPE=redis)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5
REDIS_READ_TIMEOUT=3
REDIS_WRITE_TIMEOUT=3

# Gmail SMTP Email service configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your_gmail_username@gmail.com
EMAIL_SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM_NAME=Weather API
EMAIL_FROM_ADDRESS=your_gmail_username@gmail.com

# Application URL (used for email links)
APP_URL=http://localhost:8080

# Scheduler configuration in minutes
HOURLY_INTERVAL=60
DAILY_INTERVAL=1440

# Message Broker configuration (NATS)
MESSAGE_BROKER_URL=nats://localhost:4222
MESSAGE_BROKER_USERNAME=
MESSAGE_BROKER_PASSWORD=