.PHONY: test-unit test-integration test-e2e test-architecture test-all test-clean test-deps lint help
.PHONY: _check-docker _check-node _e2e-setup _e2e-cleanup
.PHONY: test-integration-weather test-integration-user test-integration-subscription test-integration-notification
.PHONY: test-integration-isolated test-integration-microservices

# Configuration
MICROSERVICES_COMPOSE_FILE := docker-compose.microservices.yml
E2E_COMPOSE_FILE := tests/e2e/docker/docker-compose.e2e.yml
MICROSERVICES_PROJECT := weatherapi-microservices
E2E_PROJECT := weatherapi-e2e-test
INTEGRATION_PACKAGES := ./tests/integration/...
UNIT_PACKAGES := ./internal/... ./pkg/...
TIMEOUT := 5m

# Service URLs for microservices testing (for E2E only)
GATEWAY_URL := http://localhost:8080
WEATHER_SERVICE_URL := http://localhost:8081
USER_SERVICE_URL := http://localhost:8082
SUBSCRIPTION_SERVICE_URL := http://localhost:8083
NOTIFICATION_SERVICE_URL := http://localhost:8084

# Colors for output
GREEN := \033[32m
YELLOW := \033[33m
RED := \033[31m
BLUE := \033[34m
NC := \033[0m

# Default target
help:
	@echo "$(GREEN)Weather API Testing Commands$(NC)"
	@echo ""
	@echo "$(YELLOW)Core Commands:$(NC)"
	@echo "  test-unit                    - Run unit tests"
	@echo "  test-integration             - Run integration tests (service isolation - fast)"
	@echo "  test-integration-isolated    - Same as test-integration (recommended)"
	@echo "  test-integration-microservices - Run full microservices stack for E2E-style testing"
	@echo "  test-e2e                     - Run E2E tests with full stack"
	@echo "  test-architecture            - Run architecture tests"
	@echo "  test-all                     - Run all tests sequentially"
	@echo ""
	@echo "$(YELLOW)Individual Service Integration Tests:$(NC)"
	@echo "  test-integration-weather     - Test Weather Service only"
	@echo "  test-integration-user        - Test User Service only"
	@echo "  test-integration-subscription - Test Subscription Service only"
	@echo "  test-integration-notification - Test Notification Service only"
	@echo ""
	@echo "$(YELLOW)Microservices Commands (for E2E/debugging):$(NC)"
	@echo "  microservices-up             - Start microservices stack"
	@echo "  microservices-down           - Stop microservices stack"
	@echo "  microservices-logs           - View microservices logs"
	@echo ""
	@echo "$(YELLOW)Utilities:$(NC)"
	@echo "  test-clean                   - Clean up all test environments"
	@echo "  test-deps                    - Install/verify test dependencies"
	@echo "  lint                         - Run code linting" 
	@echo "  help                         - Show this help message"
	@echo ""
	@echo "$(YELLOW)Testing Philosophy:$(NC)"
	@echo "  • Integration tests: Service isolation with mocked dependencies (fast)"
	@echo "  • E2E tests: Full microservices stack with real communication (slower)"
	@echo ""
	@echo "$(YELLOW)Examples:$(NC)"
	@echo "  make test-unit                         # Quick unit tests"
	@echo "  make test-integration                  # Service isolation integration (recommended)"
	@echo "  make test-integration-weather          # Test only Weather Service"
	@echo "  make test-integration-microservices    # Full stack testing"
	@echo "  make test-all                          # Complete test suite"

# Unit Tests - Fast and simple
test-unit:
	@echo "$(GREEN)Running unit tests...$(NC)"
	@go test -v -race -timeout=$(TIMEOUT) -coverprofile=coverage.out $(UNIT_PACKAGES)
	@echo "$(GREEN)Unit tests completed$(NC)"

# Integration Tests - Service Isolation (NEW DEFAULT - Fast and Reliable)
test-integration:
	@echo "$(GREEN)Running integration tests (service isolation)...$(NC)"
	@echo "$(YELLOW)Testing individual services with mocked dependencies...$(NC)"
	@go test -v -timeout=$(TIMEOUT) $(INTEGRATION_PACKAGES)
	@echo "$(GREEN)Service isolation integration tests completed$(NC)"

# Alias for clarity
test-integration-isolated: test-integration

# Individual Service Integration Tests
test-integration-weather:
	@echo "$(GREEN)Running Weather Service integration tests...$(NC)"
	@go test -v -timeout=$(TIMEOUT) ./tests/integration/weather/
	@echo "$(GREEN)Weather Service integration tests completed$(NC)"

test-integration-user:
	@echo "$(GREEN)Running User Service integration tests...$(NC)"
	@go test -v -timeout=$(TIMEOUT) ./tests/integration/user/
	@echo "$(GREEN)User Service integration tests completed$(NC)"

test-integration-subscription:
	@echo "$(GREEN)Running Subscription Service integration tests...$(NC)"
	@go test -v -timeout=$(TIMEOUT) ./tests/integration/subscription/
	@echo "$(GREEN)Subscription Service integration tests completed$(NC)"

test-integration-notification:
	@echo "$(GREEN)Running Notification Service integration tests...$(NC)"
	@go test -v -timeout=$(TIMEOUT) ./tests/integration/notification/
	@echo "$(GREEN)Notification Service integration tests completed$(NC)"

# Integration Tests - Full Microservices Stack (for E2E-style testing)
test-integration-microservices: _check-docker
	@echo "$(GREEN)Running integration tests (full microservices stack)...$(NC)"
	@echo "$(YELLOW)⚠️  This requires all services to be running - consider using 'test-integration' instead$(NC)"
	@echo "$(YELLOW)Starting microservices stack...$(NC)"
	@make -f Makefile.testing microservices-up
	@set -e; \
	ROOT_DIR=$$(pwd); \
	trap "cd $$ROOT_DIR && make -f Makefile.testing microservices-down" EXIT; \
	echo "$(YELLOW)Waiting for services to start...$(NC)"; \
	sleep 30; \
	echo "$(GREEN)Running full stack integration tests...$(NC)"; \
	INTEGRATION_TEST_MODE=microservices go test -v -timeout=$(TIMEOUT) $(INTEGRATION_PACKAGES)
	@echo "$(GREEN)Full stack integration tests completed$(NC)"

# E2E Tests - With auto setup/cleanup
test-e2e: _check-docker _check-node _e2e-setup
	@echo "$(GREEN)Running E2E tests...$(NC)"
	@set -e; \
	ROOT_DIR=$$(pwd); \
	trap "cd $$ROOT_DIR && make -f Makefile.testing _e2e-cleanup" EXIT; \
	cd tests/e2e && npm test
	@echo "$(GREEN)E2E tests completed$(NC)"

# Architecture Tests - Validate hexagonal architecture rules
test-architecture:
	@echo "$(GREEN)Running architecture tests...$(NC)"
	@if ! command -v go-arch-lint >/dev/null 2>&1; then \
		echo "$(YELLOW)Installing go-arch-lint...$(NC)"; \
		go install github.com/fe3dback/go-arch-lint@latest; \
	fi
	@go-arch-lint check
	@echo "$(YELLOW)Running custom architecture tests...$(NC)"
	@go test -v ./tests/architecture/...
	@echo "$(GREEN)Architecture tests completed$(NC)"

# Run all tests sequentially (using fast service isolation for integration)
test-all: test-unit test-architecture test-integration
	@echo "$(GREEN)All tests completed successfully!$(NC)"
	@echo "$(YELLOW)Note: Used service isolation for integration tests (fast). Run 'make test-integration-microservices' for full stack testing.$(NC)"

# Microservices Management Commands (primarily for E2E testing and debugging)
microservices-up: _check-docker
	@echo "$(GREEN)Starting microservices stack...$(NC)"
	@echo "$(YELLOW)Note: This is mainly for E2E testing. Integration tests use service isolation.$(NC)"
	@docker compose -f $(MICROSERVICES_COMPOSE_FILE) up -d --build
	@echo "$(YELLOW)Microservices started. Waiting for startup...$(NC)"
	@sleep 10
	@echo "$(GREEN)Microservices should be ready for E2E testing$(NC)"

microservices-down:
	@echo "$(GREEN)Stopping microservices stack...$(NC)"
	@docker compose -f $(MICROSERVICES_COMPOSE_FILE) down --volumes
	@echo "$(GREEN)Microservices stopped$(NC)"

microservices-logs:
	@echo "$(GREEN)Showing microservices logs...$(NC)"
	@docker compose -f $(MICROSERVICES_COMPOSE_FILE) logs -f

# Linting
lint:
	@echo "$(GREEN)Running linter...$(NC)"
	@if ! command -v golangci-lint >/dev/null 2>&1; then \
		echo "$(YELLOW)Installing golangci-lint...$(NC)"; \
		go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.1.6; \
	fi
	@golangci-lint run ./...
	@echo "$(GREEN)Linting completed$(NC)"

# Install/verify test dependencies
test-deps: _check-docker _check-node
	@echo "$(GREEN)Installing test dependencies...$(NC)"
	@go mod download
	@if [ -d "tests/e2e" ]; then \
		cd tests/e2e && npm install; \
		cd tests/e2e && npx playwright install chromium firefox; \
	fi
	@echo "$(GREEN)Test dependencies installed$(NC)"

# Clean up all test environments
test-clean:
	@echo "$(GREEN)Cleaning up test environments...$(NC)"
	@make -f Makefile.testing microservices-down || true
	@make -f Makefile.testing _e2e-cleanup || true
	@docker system prune -f --filter "label=weatherapi-test" 2>/dev/null || true
	@echo "$(GREEN)Test environments cleaned$(NC)"

# Internal: Check Docker availability
_check-docker:
	@if ! command -v docker >/dev/null 2>&1; then \
		echo "$(RED)Error: Docker is required but not installed$(NC)"; \
		exit 1; \
	fi
	@if ! docker info >/dev/null 2>&1; then \
		echo "$(RED)Error: Docker daemon is not running$(NC)"; \
		exit 1; \
	fi
	@if ! docker compose version >/dev/null 2>&1; then \
		echo "$(RED)Error: docker compose is required but not installed$(NC)"; \
		exit 1; \
	fi

# Internal: Check Node.js availability
_check-node:
	@if ! command -v node >/dev/null 2>&1; then \
		echo "$(RED)Error: Node.js is required for E2E tests$(NC)"; \
		exit 1; \
	fi
	@if ! command -v npm >/dev/null 2>&1; then \
		echo "$(RED)Error: npm is required for E2E tests$(NC)"; \
		exit 1; \
	fi

# Internal: Setup E2E test environment  
_e2e-setup:
	@echo "$(YELLOW)Setting up E2E test environment...$(NC)"
	@if [ -f "$(E2E_COMPOSE_FILE)" ]; then \
		docker compose -f $(E2E_COMPOSE_FILE) -p $(E2E_PROJECT) down --volumes >/dev/null 2>&1 || true; \
		docker compose -f $(E2E_COMPOSE_FILE) -p $(E2E_PROJECT) build --quiet; \
		docker compose -f $(E2E_COMPOSE_FILE) -p $(E2E_PROJECT) up -d; \
		echo "$(YELLOW)Waiting for E2E services...$(NC)"; \
		sleep 20; \
		echo "$(GREEN)E2E services should be ready$(NC)"; \
	else \
		echo "$(YELLOW)E2E compose file not found, using microservices for E2E testing$(NC)"; \
		make -f Makefile.testing microservices-up; \
		sleep 20; \
	fi

# Internal: Cleanup E2E test environment
_e2e-cleanup:
	@echo "$(YELLOW)Cleaning up E2E test environment...$(NC)"
	@if [ -f weatherapi.pid ]; then \
		kill $$(cat weatherapi.pid) 2>/dev/null || true; \
		rm -f weatherapi.pid; \
	fi
	@rm -f weatherapi
	@if [ -f "$(E2E_COMPOSE_FILE)" ]; then \
		docker compose -f $(E2E_COMPOSE_FILE) -p $(E2E_PROJECT) down --volumes >/dev/null 2>&1 || true; \
	fi

# Development helpers (for debugging microservices)
dev-setup: microservices-up
	@echo "$(GREEN)Development environment ready!$(NC)"
	@echo "$(YELLOW)Services available at:$(NC)"
	@echo "  API Gateway:         $(GATEWAY_URL)"
	@echo "  Weather Service:     $(WEATHER_SERVICE_URL)"  
	@echo "  User Service:        $(USER_SERVICE_URL)"
	@echo "  Subscription Service: $(SUBSCRIPTION_SERVICE_URL)"
	@echo "  Notification Service: $(NOTIFICATION_SERVICE_URL)"
	@echo ""
	@echo "$(YELLOW)For testing:$(NC)"
	@echo "  • 'make test-integration' - Fast service isolation tests (recommended)"
	@echo "  • 'make test-integration-microservices' - Full stack integration tests"

dev-teardown: microservices-down
	@echo "$(GREEN)Development environment stopped$(NC)"
